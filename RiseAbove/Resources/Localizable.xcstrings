        }
      }
    },
    "You can pick several. Your choice decides which disciplines and charts you see." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно выбрать несколько. От выбора зависят дисциплины и графики, которые ты увидишь."
          }
        }
      }
    },
    "You set your own targets for this goal. They can be changed in the goal settings." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
