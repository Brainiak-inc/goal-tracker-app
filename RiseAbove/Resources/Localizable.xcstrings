    "Changes the text size in this app on top of the iOS setting. For even larger text: iOS Settings → Accessibility → Display & Text Size." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет размер текста в этом приложении поверх настройки iOS. Для ещё более крупного текста: Настройки iOS → Универсальный доступ → Дисплей и размер текста."
          }
        }
      }
    },
    "Check that Health is available on this iPhone and try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь, что «Здоровье» доступно на этом iPhone, и попробуй ещё раз."
          }
        }
      }
    },
    "Choose a CSV file exported from Garmin Connect: Activities → Export CSV." : {
      "localizations" : {
